# Claude Code local settings
.claude/

# Local user config - contains the Plex auth token, never publish
config.json

# Local tool cache
.freebuff/

# Python bytecode
__pycache__/
*.pyc

# PyInstaller build output
build/
dist/

# NVDA controller client, fetched at build time by tools/ensure_nvda_controller_client.py
bin/

# Release zips (published as GitHub release assets, not tracked here)
*.zip

# Local release artifacts
release/*.local.*
release/published_at.txt
release/signing_thumbprint.txt
release/zip_hash.txt
